# FacultyInsight AI — backend environment template.
# Copy to backend/.env (or set real environment variables) and adjust.
# Never commit real secrets.

APP_ENV=development
API_PREFIX=/api

JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=30

DB_HOST=localhost
DB_PORT=5432
DB_NAME=faculty_feedback
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
# DATABASE_URL=postgresql://postgres:replace-with-your-postgres-password@localhost:5432/faculty_feedback

CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://localhost:8080

LOGIN_RATE_LIMIT=12
LOGIN_RATE_WINDOW_SECONDS=300
